import random

Guess = random.randint(1, 10)

while True:
    num = int(input("Enter a number from 1 to 10: "))

    if num > Guess:
        print("Number is bigger")

    elif num < Guess:
        print("Number is smaller")

    else:
        print("Number is equal")
        break


